# Production env for docker-compose.prod.external.yml.
#   cp .env.production.example .env
# Fill every change-me. .env is gitignored — never commit secrets.
# No LLM_* in v1.

NODE_ENV=production
PORT=3010
LOG_LEVEL=info

# ----- image / host bind (compose interpolation; API stays loopback) -----
VITAL_IMAGE_TAG=stable
VITAL_API_BIND=127.0.0.1
VITAL_API_PORT=3010

# Same-host Docker: host.docker.internal (Postgres must listen on the docker
# bridge, not only 127.0.0.1). Native on the host: 127.0.0.1.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=vital_prod_user
PG_PASSWORD=change-me
PG_DATABASE=vital_prod
PG_SSL=false

# Distinct per environment and from each other. min 32 chars.
# openssl rand -base64 48
JWT_SECRET=change-me-prod-jwt-secret-min-32-chars
COOKIE_SECRET=change-me-prod-cookie-secret-min-32-xx
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

ATTACHMENT_S3_BUCKET=vital
ATTACHMENT_S3_PREFIX=prod/attachments
ATTACHMENT_S3_ACCESS_KEY_ID=change-me
ATTACHMENT_S3_SECRET_ACCESS_KEY=change-me
ATTACHMENT_S3_REGION=cn-beijing
ATTACHMENT_S3_ENDPOINT=https://s3.aimo.plus
ATTACHMENT_S3_IS_PUBLIC=false
PRESIGN_GET_TTL_SECONDS=21600
PRESIGN_PUT_TTL_SECONDS=900
MEDIA_UPLOADING_TTL_HOURS=24
SWEEPER_INTERVAL_MS=3600000
SWEEPER_DRY_RUN=true

# Deploy-time. Real https origin nginx serves (cookie + CORS).
# Do not put a placeholder hostname here — Origin must match or cookies will not issue.
WEB_ORIGIN=
COOKIE_SECURE=true
