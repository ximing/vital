# Local unpacked / `pnpm dev` / `pnpm build` / `pnpm zip`.
# Defaults in origins.ts are the same; copy this file only to override.
WXT_API_URL=http://localhost:3010
WXT_WEB_URL=http://localhost:5180
WXT_S3_ENDPOINT=https://s3.aimo.plus

# Chrome Web Store package: `pnpm zip:store` (writes dist-store/, copies to store-listing/).
# Do not put production URLs in `.env` or a local `pnpm build` will hit the live API.
