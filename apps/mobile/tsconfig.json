{
  "extends": "@vital/tsconfig/app.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM"
    ],
    "declaration": false,
    "types": []
  },
  "include": [
    "app.config.ts",
    "vitest.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
