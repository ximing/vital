# Absolute API origin (bearer). Dev default matches apps/server :3010.
WXT_API_URL=http://localhost:3010
# Web app origin — "打开网页版" and prod host_permissions when API is same-origin nginx.
WXT_WEB_URL=http://localhost:5180
# Presigned PUT host. SW fetch cannot reach S3 without this origin in host_permissions.
WXT_S3_ENDPOINT=https://s3.aimo.plus
