{
  "name": "@vital/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src/ vite.config.ts vitest.config.ts",
    "preview": "vite preview --port 5180 --strictPort",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.67.2",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@vital/api-client": "workspace:*",
    "@vital/dto": "workspace:*",
    "@vital/tokens": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "^7.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vital/eslint-config": "workspace:*",
    "@vital/tsconfig": "workspace:*",
    "eslint": "^9.19.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.11"
  }
