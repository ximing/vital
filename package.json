{
  "name": "vital",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "skills"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "typecheck": "turbo typecheck",
    "gen:vital-skill": "pnpm --filter @vital/dto build && pnpm --filter @vital/server gen:vital-skill"
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "turbo": "^2.4.2",
    "typescript": "^7.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "typescript": "5.9.3"
    }
  }
}
