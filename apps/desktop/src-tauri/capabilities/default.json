{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: plugin-http (API + S3), plugin-store, window-state",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["http://localhost:5180/*", "http://127.0.0.1:5180/*"]
  },
  "permissions": [
    "core:default",
    "store:default",
    "window-state:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:3010/*" },
        { "url": "http://localhost:3010/*" },
        { "url": "https://*/*" },
        { "url": "https://*:*/*" }
      ]
    }
  ]
}
