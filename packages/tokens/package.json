{
  "name": "@vital/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/semantic.css": "./src/css/semantic.css",
    "./logo.svg": "./src/logo.svg",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/ __tests__/",
    "test": "vitest run",
    "raster-icons": "node scripts/raster-icons.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vital/eslint-config": "workspace:*",
    "@vital/tsconfig": "workspace:*",
    "eslint": "^9.19.0",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
