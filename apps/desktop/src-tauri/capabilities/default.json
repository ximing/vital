{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop shell commands for chrome and sticky alerts, plus system notifications.",
  "windows": ["main", "notify-alert"],
  "local": true,
  "permissions": [
    "allow-apply-chrome",
    "allow-show-sticky-alert",
    "allow-close-sticky-alert",
    "allow-open-in-main",
    "allow-open-external",
    "allow-hide-main",
    "allow-set-badge",
    "notification:default"
  ]
}
